# Copy to .env and fill in. Never commit .env or paste these values anywhere.
# Every variable is explained in application/ENVIRONMENT.md.

# --- Sabre (developer.sabre.com > My account > Applications) ---
# As shown on Sabre's test credentials page:
SABRE_USER_ID=
SABRE_PASSWORD=
SABRE_PCC=
# Only if Sabre gives you a ready-made client ID/secret instead (overrides the three above):
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=
# Host only. The app adds /v2/auth/token and /v5/offers/shop itself.
SABRE_BASE_URL=https://api.cert.platform.sabre.com
# true = generated sample flights; false = live Sabre. Defaults to true when credentials are missing.
USE_MOCK=true

# --- Database: pick ONE way, or leave all empty for a local SQLite file (./flynow.db) ---
# A) The parts, as the ECS task definition passes them (MySQL by default):
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# DB_DRIVER=mysql+aiomysql
# B) Or one full URL (wins over the parts if set):
# DATABASE_URL=mysql+aiomysql://user:password@host:3306/flynow_db_dev

# --- Optional ---
# Only needed when the frontend is served from a different origin than the API (not behind the nginx proxy).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# How long search results stay cached for the detail page, in minutes.
# SEARCH_TTL_MINUTES=30









