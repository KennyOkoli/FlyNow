# Copy to .env and fill in from developer.sabre.com > My account > Applications.
# Never commit .env or paste these values anywhere.

# As shown on Sabre's test credentials page:
SABRE_USER_ID=
SABRE_PASSWORD=
SABRE_PCC=

# Only if Sabre gives you a ready-made client ID/secret instead (overrides the three above):
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=

SABRE_BASE_URL=https://api.cert.platform.sabre.com
# true = generated sample flights; false = live Sabre. Defaults to true when credentials are missing.
USE_MOCK=true

# Where searches are saved. SQLite file by default; for Postgres use
# postgresql+asyncpg://user:password@localhost:5432/flynow (and `uv add asyncpg`).
DATABASE_URL=sqlite+aiosqlite:///./flynow.db
